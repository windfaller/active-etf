{
  "routes": [
    {
      "route": "/sitemap.xml",
      "rewrite": "/api/sitemap.xml"
    },
    {
      "route": "/robots.txt",
      "rewrite": "/api/robots.txt"
    },
    {
      "route": "/",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/app-version.json",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/market",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/etf/*",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/global-etfs",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/global-etfs/*",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/assets/index-cTTlnrt5.js",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/assets/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/assets/*",
      "/active-etfs/*",
      "/sitemap.xml",
      "/robots.txt",
      "/favicon.svg",
      "/*.json",
      "/*.xml",
      "/*.txt",
      "/*.svg",
      "/*.png",
      "/*.webp",
      "/*.ico"
    ]
  }
}
